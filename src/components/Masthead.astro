---
import { REPO, href } from '../data/site';

interface Props {
  current?: 'home' | 'docs';
}
const { current = 'home' } = Astro.props;
const now = new Date();
const stamp = `${String(now.getUTCDate()).padStart(2, '0')} ${now
  .toLocaleString('en-US', { month: 'short', timeZone: 'UTC' })
  .toUpperCase()} ${now.getUTCFullYear()} ${String(now.getUTCHours()).padStart(2, '0')}00 UTC`;
const links = [
  { label: 'Products', to: href('/#products'), wide: true },
  { label: 'Tropical', to: href('/#tropical'), wide: true },
  { label: 'Install', to: href('/#install') },
  { label: 'Docs', to: href('/docs/'), active: current === 'docs' },
];
---

<header class="masthead">
  <a class="brand" href={href('/')} aria-label="rustywx home">
    <img src={href('/logo-mark.svg')} alt="" width="30" height="30" />
    <span class="word">rusty<span>wx</span></span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {
        links.map((l) => (
          <li class:list={[{ wide: l.wide }]}>
            <a href={l.to} aria-current={l.active ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li><a href={REPO}>GitHub</a></li>
    </ul>
  </nav>
  <p class="valid">
    <span class="lettering">Valid</span>
    <time data-valid datetime={now.toISOString()}>{stamp}</time>
  </p>
</header>

<script>
  const el = document.querySelector<HTMLTimeElement>('[data-valid]');
  const tick = () => {
    if (!el) return;
    const d = new Date();
    const mon = d.toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }).toUpperCase();
    const hh = String(d.getUTCHours()).padStart(2, '0');
    const mm = String(d.getUTCMinutes()).padStart(2, '0');
    el.textContent = `${String(d.getUTCDate()).padStart(2, '0')} ${mon} ${d.getUTCFullYear()} ${hh}${mm} UTC`;
    el.dateTime = d.toISOString();
  };
  tick();
  setInterval(tick, 30_000);
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 40px);
    height: 56px;
    padding: 0 var(--gutter);
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
    box-shadow: 0 3px 0 -2px var(--paper), 0 4px 0 -2px var(--ink);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .word {
    font-size: 1.4rem;
    font-weight: 850;
    font-variation-settings: 'wdth' 112;
    letter-spacing: -0.03em;
    color: var(--cold);
  }

  .word span {
    color: var(--warm);
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: clamp(14px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    font-variation-settings: 'wdth' 80;
    font-weight: 650;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--cold-deep);
    border-bottom-color: var(--cold);
  }

  .valid {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding-left: clamp(12px, 2vw, 24px);
    border-left: 1px solid var(--rule);
    white-space: nowrap;
  }

  .valid time {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
  }

  @media (max-width: 860px) {
    .valid {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .wide {
      display: none;
    }
    .word {
      font-size: 1.2rem;
    }
  }
</style>
