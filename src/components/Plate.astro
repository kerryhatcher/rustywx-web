---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Note {
  x: number;
  y: number;
  at?: number;
  title: string;
  text: string;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  notes: Note[];
  id: string;
}

const { src, alt, caption, notes, id } = Astro.props;
// The image takes the left 68% of the figure; notes start at 72%.
const IMG = 68;
const NOTE_X = 72;
const placed = notes.map((n, i) => ({ ...n, n: i + 1, at: n.at ?? n.y }));
---

<figure class="plate" id={id}>
  <div class="frame">
    <div class="shot">
      <Image src={src} alt={alt} widths={[640, 960, 1329]} sizes="(min-width: 900px) 64vw, 100vw" loading="lazy" />
      {
        placed.map((p) => (
          <span class="marker" style={`left:${p.x}%;top:${p.y}%`} aria-hidden="true">
            {p.n}
          </span>
        ))
      }
    </div>
    <svg class="leaders" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {
        placed.map((p) => (
          <polyline
            points={`${((p.x * IMG) / 100).toFixed(2)},${p.y} ${IMG + 1.2},${p.at} ${NOTE_X - 0.6},${p.at}`}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </svg>
    <ol class="notes">
      {
        placed.map((p) => (
          <li style={`--at:${p.at}%`}>
            <span class="num value" aria-hidden="true">
              {p.n}
            </span>
            <span>
              <strong>{p.title}</strong> {p.text}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .plate {
    margin: 0;
  }

  .frame {
    position: relative;
  }

  .shot {
    position: relative;
    width: 68%;
    border: 1px solid var(--ink);
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--ink);
    background: var(--scope);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
  }

  .marker {
    position: absolute;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--warm-ink);
    color: #fff;
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--ink), 0 2px 6px rgb(0 0 0 / 0.35);
  }

  .leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .leaders polyline {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }

  .notes {
    position: absolute;
    inset: 0 0 0 72%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes li {
    position: absolute;
    top: var(--at);
    translate: 0 -0.9em;
    display: grid;
    grid-template-columns: 1.6em 1fr;
    gap: 6px;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .notes strong {
    color: var(--ink);
    font-weight: 700;
  }

  .num {
    color: var(--warm-ink);
    font-weight: 700;
  }

  figcaption {
    margin-top: 18px;
    width: 68%;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  @media (max-width: 899px) {
    .shot,
    figcaption {
      width: 100%;
    }
    .leaders {
      display: none;
    }
    .notes {
      position: static;
      display: grid;
      gap: 12px;
      margin-top: 24px;
    }
    .notes li {
      position: static;
      translate: none;
    }
    .marker {
      width: 18px;
      height: 18px;
      font-size: 10px;
    }
  }
</style>
