---
import { buildAnalysis, VIEW_W, VIEW_H, INSET } from '../lib/analysis';

const a = buildAnalysis();
const kjgx = a.sites.find((s) => s.id === 'KJGX')!;
const leader = { x1: kjgx.x, y1: kjgx.y + 6, x2: kjgx.x, y2: INSET.y };
---

<svg
  class="analysis"
  viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
  preserveAspectRatio="xMidYMid meet"
  aria-hidden="true"
  focusable="false"
  data-analysis
>
  <defs>
    <pattern id="rain-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="7" height="7" fill="#3e9b4f" fill-opacity="0.14"></rect>
      <line x1="0" y1="0" x2="0" y2="7" stroke="#3e9b4f" stroke-width="2" stroke-opacity="0.55"></line>
    </pattern>
  </defs>

  <rect class="water" width={VIEW_W} height={VIEW_H}></rect>
  <path class="neighbours" d={a.neighbours}></path>
  <path class="land" d={a.states}></path>
  <path class="graticule" d={a.graticule}></path>
  <path class="rain draft-fade" d={a.rain}></path>
  <path class="state-lines" d={a.stateLines}></path>
  <path class="nation" d={a.nation}></path>

  <g class="isobars">
    {a.isobars.map((i) => <path class="isobar draft-line" d={i.d} pathLength="1" />)}
  </g>
  <g class="isobar-labels draft-fade">
    {
      a.isobars.flatMap((i) =>
        i.labels.map((l) => (
          <text x={l.x} y={l.y + 4}>
            {l.text}
          </text>
        )),
      )
    }
  </g>

  <g class="front cold">
    <path class="front-line draft-line" d={a.cold.line} pathLength="1"></path>
    {a.cold.symbols.map((d, i) => <path class="stamp" d={d} style={`--i:${i}`} />)}
  </g>
  <g class="front warm">
    <path class="front-line draft-line" d={a.warm.line} pathLength="1"></path>
    {a.warm.symbols.map((d, i) => <path class="stamp" d={d} style={`--i:${i}`} />)}
  </g>

  <g class="centers">
    {
      a.centers.map((c) => (
        <g class:list={['center', c.kind === 'H' ? 'high' : 'low']} transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)})`}>
          <text class="letter" y="22">
            {c.kind}
          </text>
          <text class="mb" y="46">
            {c.mb}
          </text>
        </g>
      ))
    }
  </g>

  <g class="grat-labels">
    {
      a.gratLabels.map((g) => (
        <text x={g.x} y={g.y} text-anchor={g.axis === 'lon' ? 'middle' : 'end'} dy={g.axis === 'lon' ? 18 : 4}>
          {g.text}
        </text>
      ))
    }
  </g>

  <text class="ocean" x="1556" y="452" transform="rotate(-72 1556 452)">Atlantic Ocean</text>

  <g class="rings" data-rings transform={`translate(${kjgx.x} ${kjgx.y})`}>
    <circle class="ring outer" r={(230 * kjgx.k).toFixed(1)} data-ring="230"></circle>
    <circle class="ring inner" r={(115 * kjgx.k).toFixed(1)} data-ring="115"></circle>
    <path class="spokes" d={`M0,-${(230 * kjgx.k).toFixed(1)}V${(230 * kjgx.k).toFixed(1)}M-${(230 * kjgx.k).toFixed(1)},0H${(230 * kjgx.k).toFixed(1)}`} data-spokes></path>
  </g>

  <g class="sites" data-sites>
    {
      a.sites.map((s) => (
        <circle
          class:list={['site', { selected: s.id === 'KJGX' }]}
          cx={s.x}
          cy={s.y}
          r="3.6"
          data-id={s.id}
          data-name={s.name}
          data-lat={s.lat}
          data-lon={s.lon}
          data-k={s.k}
        />
      ))
    }
  </g>

  <line class="leader" x1={leader.x1} y1={leader.y1} x2={leader.x2} y2={leader.y2}></line>
  <circle class="leader-dot" cx={leader.x2} cy={leader.y2} r="3"></circle>

  <g class="site-tag" data-tag transform={`translate(${kjgx.x} ${kjgx.y})`}>
    <rect x="9" y="-31" width="66" height="22" rx="1"></rect>
    <text x="14" y="-15" data-tag-text>KJGX</text>
  </g>
</svg>

<style>
  .analysis {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .water {
    fill: var(--water);
  }
  .neighbours {
    fill: #ecf1ef;
    stroke: var(--rule-strong);
    stroke-width: 0.7;
    stroke-dasharray: 4 3;
  }
  .land {
    fill: var(--land);
  }
  .graticule {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.13;
    stroke-width: 0.7;
  }
  .rain {
    fill: url(#rain-hatch);
    stroke: var(--rain);
    stroke-width: 1.1;
  }
  .state-lines {
    fill: none;
    stroke: var(--ink);
    stroke-opacity: 0.38;
    stroke-width: 0.7;
  }
  .nation {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .isobar {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.15;
    stroke-linejoin: round;
  }
  .isobar-labels text {
    font-family: var(--mono);
    font-size: 13px;
    fill: var(--ink);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--land);
    stroke-width: 5px;
  }
  .front-line {
    fill: none;
    stroke-width: 3.2;
    stroke-linecap: round;
  }
  .cold .front-line {
    stroke: var(--cold);
  }
  .cold .stamp {
    fill: var(--cold);
  }
  .warm .front-line {
    stroke: var(--warm);
  }
  .warm .stamp {
    fill: var(--warm);
  }
  .center text {
    text-anchor: middle;
  }
  .letter {
    font-family: var(--sans);
    font-variation-settings: 'wdth' 125;
    font-weight: 900;
    font-size: 64px;
  }
  .high .letter {
    fill: var(--cold);
  }
  .low .letter {
    fill: var(--warm);
  }
  .mb {
    font-family: var(--mono);
    font-size: 14px;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--land);
    stroke-width: 4px;
  }
  .grat-labels text {
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--ink-2);
  }
  .ocean {
    font-family: var(--sans);
    font-variation-settings: 'wdth' 72;
    font-weight: 600;
    font-style: italic;
    font-size: 13px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    fill: var(--ink-3);
  }
  .ring,
  .spokes {
    fill: none;
    stroke: var(--warm-ink);
    stroke-width: 1.2;
  }
  .ring.inner,
  .spokes {
    stroke-dasharray: 3 4;
    stroke-opacity: 0.8;
  }
  .rings {
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site {
    fill: var(--land);
    stroke: var(--ink);
    stroke-width: 1.1;
    cursor: pointer;
    transition: r 160ms ease-out;
  }
  .site:hover {
    stroke-width: 2;
  }
  .site.selected {
    fill: var(--warm);
    stroke: var(--ink);
    stroke-width: 1.4;
    r: 5.5;
  }
  .leader {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .leader-dot {
    fill: var(--ink);
  }
  .site-tag {
    pointer-events: none;
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site-tag rect {
    fill: var(--ink);
  }
  .site-tag text {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    fill: var(--paper);
  }

  @media (max-width: 899px) {
    .leader,
    .leader-dot {
      display: none;
    }
  }

  /* One drafting pass on first load; JS adds .drafting, so no-JS shows the finished sheet. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.drafting) .draft-line {
      stroke-dasharray: 1;
      animation: draft 1800ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    :global(.drafting) .front-line {
      animation-delay: 700ms;
    }
    :global(.drafting) .draft-fade {
      animation: fade 900ms 1100ms ease-out both;
    }
    :global(.drafting) .stamp {
      transform-box: fill-box;
      transform-origin: center;
      animation: stamp 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(1100ms + var(--i) * 70ms);
    }
    :global(.drafting) .center {
      animation: fade 500ms 1700ms ease-out both;
    }
  }

  @keyframes draft {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes stamp {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }
</style>
