---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AnalysisMap from '../components/AnalysisMap.astro';
import InstallKey from '../components/InstallKey.astro';
import Plate from '../components/Plate.astro';
import Symbol from '../components/Symbol.astro';
import radarShot from '../assets/screenshot-radar.png';
import forecastShot from '../assets/screenshot-forecast-crop.png';
import legends from '../data/legends.json';
import sites from '../data/sites.json';
import { INSET, VIEW_W, VIEW_H } from '../lib/analysis';
import { DOWNLOADS, VERSION, RELEASED, RELEASE_TAG, REPO, CRATE, href } from '../data/site';

const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const kjgx = sites.find((s) => s.id === 'KJGX')!;

type Legend = { v: number; hex: string }[];
const products: {
  key: string;
  name: string;
  short: string;
  unit: string;
  legend: Legend;
  reads: string;
  derived?: boolean;
}[] = [
  { key: 'R', name: 'Reflectivity', short: 'Z', unit: 'dBZ', legend: legends.DBZ_LEGEND, reads: 'How much energy came back, so how hard it is raining. Greens are light rain, reds are heavy, magenta and white above 60 dBZ usually mean hail.' },
  { key: 'V', name: 'Velocity', short: 'V', unit: 'm/s', legend: legends.VELOCITY_LEGEND, reads: 'Motion toward the radar in green, away in red. A tight green-red couplet is rotation. Values near the Nyquist limit can fold, so dealiasing is on by default.' },
  { key: 'W', name: 'Spectrum Width', short: 'SW', unit: 'm/s', legend: legends.SPECTRUM_WIDTH_LEGEND, reads: 'How spread out the velocities are inside each sample. High values flag turbulence, shear and mixed targets, and often rise before rotation shows.' },
  { key: 'Z', name: 'Differential Reflectivity', short: 'ZDR', unit: 'dB', legend: legends.ZDR_LEGEND, reads: 'Horizontal versus vertical return, which tells you drop shape. Big flattened raindrops run positive; tumbling hail sits near zero.' },
  { key: 'C', name: 'Correlation Coefficient', short: 'CC', unit: '', legend: legends.CC_LEGEND, reads: 'How alike the two pulses look. Rain and snow sit above 0.97. Low values mean birds, clutter, mixed hail, or lofted tornado debris.' },
  { key: 'P', name: 'Differential Phase', short: 'ΦDP', unit: '°', legend: legends.PHIDP_LEGEND, reads: 'The phase shift built up as the beam travels through liquid water. It climbs steadily along a path of heavy rain.' },
  { key: 'K', name: 'Specific Differential Phase', short: 'KDP', unit: '°/km', legend: legends.KDP_LEGEND, reads: 'How fast ΦDP rises with range: a rain-rate signal that hail barely moves. rustywx derives it on your machine from ΦDP.', derived: true },
];

const legendLabel = (v: number) => (Math.abs(v) < 1 && v !== 0 ? v.toFixed(2).replace(/0$/, '') : String(v));
const ticksFor = (l: Legend) => {
  const step = l.length > 10 ? 3 : l.length > 7 ? 2 : 1;
  return new Set(l.map((_, i) => i).filter((i) => i % step === 0 || i === l.length - 1));
};

const radarNotes = [
  { x: 52, y: 5, at: 4, title: 'Overlay toggles with live counts.', text: '14 watches and 59 warnings were active when this was captured.' },
  { x: 83, y: 9, at: 16, title: 'NHC panel.', text: 'Intensity, pressure, position, movement and advisory number for every active storm.' },
  { x: 53, y: 52, at: 32, title: 'Reflectivity from KJGX.', text: 'Decoded from the newest Level II volume on this machine.' },
  { x: 37, y: 63, at: 47, title: 'NWS warning polygons.', text: 'Drawn in their official colors, with a legend along the bottom.' },
  { x: 15, y: 70, at: 61, title: 'Forecast cone, track and points.', text: 'From the National Hurricane Center, refreshed on its own interval.' },
  { x: 80, y: 69, at: 76, title: 'Graphics and advisory text.', text: '5-day cone, key messages, wind field, wind probabilities and peak surge, plus the full public advisory.' },
  { x: 19, y: 98, at: 93, title: 'Status line.', text: 'Scan time, site, tilt count and angle, VCP, scan mode and Nyquist velocity.' },
];

const forecastNotes = [
  { x: 64, y: 17, at: 12, title: 'City search.', text: 'Geocoded with Open-Meteo, or use your saved location.' },
  { x: 58, y: 33, at: 34, title: 'Current conditions.', text: 'Temperature, feels-like, wind and humidity.' },
  { x: 72, y: 53, at: 56, title: '7-day outlook.', text: 'Highs, lows and the chance of rain each day.' },
  { x: 72, y: 82, at: 80, title: 'Hourly rain chance.', text: 'The next 24 hours as a chart.' },
];

const qc = [
  { name: 'Correlation-coefficient gating', note: 'hides non-weather echo from Reflectivity', on: true },
  { name: 'Reflectivity noise floor', note: 'drops returns too weak to be weather', on: true },
  { name: 'Velocity dealiasing', note: 'unfolds values past the Nyquist limit', on: true },
  { name: 'Velocity noise censoring', note: 'nulls gates whose local spread is noise', on: true },
  { name: 'TDBZ clutter filter', note: 'wind turbines and ground clutter, 5×5 / 9×9 / 13×13', on: true, value: '9×9' },
  { name: 'Fuzzy non-met classifier', note: 'combines CC, ZDR and ΦDP texture', on: false },
  { name: 'Radial gap-fill', note: 'heals thin gaps in the data, cosmetic', on: false },
  { name: 'Multi-scale texture filter', note: 'a more aggressive clutter pass', on: false },
  { name: 'Sun-spike and interference removal', note: 'removes isolated bright spokes', on: false },
  { name: 'Melting-layer hint', note: 'annotates the estimated bright band', on: false },
];

// The sheet keeps its graticule below the hero: one label every 400px, running south.
const marginLats = Array.from({ length: 34 }, (_, n) => {
  const lat = 20 - n;
  return lat === 0 ? '0°' : `${Math.abs(lat)}°${lat > 0 ? 'N' : 'S'}`;
});

const tropicalRows = [
  { label: 'Storm details', value: 'kt · mb · motion', x: 62, y: 12.1 },
  { label: 'Track, forecast cone and points', value: 'map layers', x: 62, y: 31.2 },
  { label: 'Wind probabilities', value: '34 kt', x: 74, y: 46.1 },
  { label: 'Earliest and most likely arrival', value: '34 kt', x: 90, y: 49.2 },
  { label: 'Graphics products', value: '5', x: 62, y: 57 },
  { label: 'Full public advisory text', value: 'in app', x: 62, y: 96.2 },
];

const keys = [
  { k: ['←', '→'], label: 'Previous / next site' },
  { k: ['T'], label: 'Next tilt' },
  { k: ['0'], label: 'Reset pan and zoom' },
  { k: ['B'], label: 'Borders' },
  { k: ['A'], label: 'Warnings' },
  { k: ['N'], label: 'Tropical data' },
  { k: ['F'], label: 'Fullscreen' },
  { k: ['?'], label: 'All shortcuts' },
];
---

<Base
  title="rustywx · live NEXRAD Level II radar for your desktop"
  description="A free, open-source desktop radar scope. rustywx streams raw NEXRAD Level II Doppler data from NOAA's public archive, decodes it on your machine, and draws it with NWS warnings, hurricane guidance and a local forecast."
>
  <main id="main">
    <div class="sheet-body">
      <div class="margin left" aria-hidden="true">
        {marginLats.map((t) => <span>{t}</span>)}
      </div>
      <div class="margin right" aria-hidden="true">
        {marginLats.map((t) => <span>{t}</span>)}
      </div>
    <section class="sheet" aria-labelledby="hero-title">
      <div class="sheet-frame">
        <div class="map-wrap">
          <script is:inline>
            document.currentScript.parentElement.classList.add('drafting');
          </script>
          <AnalysisMap />
        </div>

        <div class="pitch">
          <h1 id="hero-title" class="gothic">Live Doppler radar, straight from NOAA to your desktop.</h1>
          <p class="lede">
            rustywx is a free radar scope for macOS, Linux and Windows. It pulls raw NEXRAD Level II scans from NOAA's
            public archive, decodes them on your machine and draws them on a fast native map, with NWS warnings,
            hurricane guidance and a local forecast.
          </p>
          <p class="no">No account, API key or subscription needed</p>
          <InstallKey />
        </div>

        <figure
          class="inset"
          style={`left:${pct(INSET.x, VIEW_W)};top:${pct(INSET.y, VIEW_H)};width:${pct(INSET.w, VIEW_W)}`}
        >
          <Image
            src={radarShot}
            alt="rustywx showing live reflectivity around KJGX in Georgia, NWS warning polygons along the Gulf coast, and the National Hurricane Center panel for Tropical Storm Bertha."
            widths={[480, 720, 960]}
            sizes="(min-width: 900px) 30vw, 100vw"
            loading="eager"
          />
          <figcaption>
            <span class="value">KJGX</span> Robins AFB, Georgia. A real rustywx 0.10.2 screen.
          </figcaption>
        </figure>

        <div class="site-control" data-site-control>
          <button type="button" data-site-step="-1" aria-label="Previous radar site">
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M8 1L3 6l5 5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
          </button>
          <p aria-live="polite">
            <span class="value id" data-site-id>KJGX</span>
            <span class="name" data-site-name>{kjgx.name}</span>
            <span class="value coords" data-site-coords>{kjgx.lat.toFixed(2)}°N {Math.abs(kjgx.lon).toFixed(2)}°W</span>
          </p>
          <button type="button" data-site-step="1" aria-label="Next radar site">
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M4 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
          </button>
          <span class="hint">
            <kbd>←</kbd><kbd>→</kbd> walk all {sites.length} sites, as in the app. Rings: 115 and 230&nbsp;km.
          </span>
        </div>

        <aside class="map-key" aria-label="Map key">
          <ul>
            <li><Symbol kind="cold" /> Cold front</li>
            <li><Symbol kind="warm" /> Warm front</li>
            <li><Symbol kind="isobar" /> Isobar, mb</li>
            <li><Symbol kind="rain" /> Precipitation</li>
            <li><Symbol kind="site" /> NEXRAD site</li>
          </ul>
          <p>
            Illustrative analysis drawn for this page, not a forecast. The radar sites are the real {sites.length} in
            rustywx's site list.
          </p>
        </aside>
      </div>
    </section>

    <section class="band path" aria-labelledby="path-title">
      <header class="section-head">
        <Symbol kind="site" size="lg" />
        <h2 id="path-title" class="gothic">No middleman between you and the radar.</h2>
      </header>
      <p class="intro">
        Most radar apps show you map tiles someone else rendered. rustywx downloads the same Level II volume scans the
        National Weather Service radars produce and decodes them on your computer. Nothing passes through a rustywx
        server, because there isn't one.
      </p>
      <ol class="stations">
        <li>
          <span class="dot" aria-hidden="true"></span>
          <h3>NOAA's public archive</h3>
          <p><code>unidata-nexrad-level2</code> on AWS, the archive researchers and forecasters use.</p>
          <dl>
            <div><dt>Account</dt><dd class="value">none</dd></div>
            <div><dt>API key</dt><dd class="value">none</dd></div>
          </dl>
        </li>
        <li>
          <span class="dot" aria-hidden="true"></span>
          <h3>Polled by your machine</h3>
          <p>The newest volume for your site, fetched in the background.</p>
          <dl>
            <div><dt>Default interval</dt><dd class="value">2 min</dd></div>
            <div><dt>Retry backoff</dt><dd class="value">30 s → 600 s</dd></div>
          </dl>
        </li>
        <li>
          <span class="dot" aria-hidden="true"></span>
          <h3>Decoded locally</h3>
          <p>Raw Doppler moments unpacked with the <code>nexrad</code> crates, then cleaned by rustywx's own QC.</p>
          <dl>
            <div><dt>Products</dt><dd class="value">7</dd></div>
            <div><dt>Display range</dt><dd class="value">230 km</dd></div>
          </dl>
        </li>
        <li>
          <span class="dot" aria-hidden="true"></span>
          <h3>Drawn on your GPU</h3>
          <p>A native window rendered with ply-engine, animating smoothly between volumes.</p>
          <dl>
            <div><dt>Range rings</dt><dd class="value">10 nmi</dd></div>
            <div><dt>Telemetry</dt><dd class="value">none</dd></div>
          </dl>
        </li>
      </ol>
    </section>

    <section class="band scope" aria-labelledby="scope-title">
      <header class="section-head">
        <Symbol kind="cold" size="lg" />
        <h2 id="scope-title" class="gothic">Radar, warnings and the tropics on one scope.</h2>
      </header>
      <Plate
        id="scope-plate"
        src={radarShot}
        alt="The rustywx radar view over the Southeast US with toolbar toggles, warning polygons, a hurricane forecast cone and the NHC tropical cyclone panel."
        caption="Captured 2026-07-23 01:07 UTC on KJGX, VCP 215, 0.5° tilt. Unedited screenshot."
        notes={radarNotes}
      />
    </section>

    <section class="band products" id="products" aria-labelledby="products-title">
      <header class="section-head">
        <Symbol kind="rain" size="lg" />
        <h2 id="products-title" class="gothic">Seven products, one key each.</h2>
      </header>
      <p class="intro">
        The three classic moments plus the dual-polarization products every NEXRAD radar now records. Each one is on the
        same color table the app draws, with its values printed, so you never have to guess what a color means.
      </p>
      <ul class="product-list">
        {
          products.map((p) => {
            const ticks = ticksFor(p.legend);
            return (
              <li>
                <kbd class="pkey" aria-label={`Key ${p.key}`}>{p.key}</kbd>
                <div class="pname">
                  <h3>{p.name}</h3>
                  <span class="value">
                    {p.short}
                    {p.unit && ` · ${p.unit}`}
                    {p.derived && ' · derived'}
                  </span>
                </div>
                <p class="preads">{p.reads}</p>
                <div class="ramp" role="img" aria-label={`${p.name} color scale from ${p.legend[0].v} to ${p.legend[p.legend.length - 1].v} ${p.unit}`}>
                  <div class="swatches">
                    {p.legend.map((s) => <span style={`background:${s.hex}`} />)}
                  </div>
                  <div class="ticks value" aria-hidden="true">
                    {p.legend.map((s, i) => <span>{ticks.has(i) ? legendLabel(s.v) : ''}</span>)}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
      <div class="keystrip" aria-label="Other keyboard shortcuts">
        <h3 class="lettering">And the rest of the keyboard</h3>
        <ul>
          {
            keys.map((k) => (
              <li>
                <span class="kbds">
                  {k.k.map((c) => (
                    <kbd>{c}</kbd>
                  ))}
                </span>
                {k.label}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band tropical" id="tropical" aria-labelledby="tropical-title">
      <div class="tropical-grid">
        <div class="tropical-copy">
          <header class="section-head">
            <Symbol kind="cyclone" size="lg" />
            <h2 id="tropical-title" class="gothic">Hurricane season, in the same window.</h2>
          </header>
          <p class="intro">
            When a storm is out there, the National Hurricane Center's guidance sits on top of your radar instead of in
            another tab. Pick the storm, choose the layers, and read the advisory without leaving the scope.
          </p>
          <ol class="ledger pinned">
            {
              tropicalRows.map((r, n) => (
                <li>
                  <span class="num value" aria-hidden="true">{n + 1}</span>
                  <span>{r.label}</span>
                  <span class="value">{r.value}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <figure class="crop">
          <div class="crop-window">
            {
              tropicalRows.map((r, n) => (
                <span class="marker" style={`left:${r.x}%;top:${r.y}%`} aria-hidden="true">
                  {n + 1}
                </span>
              ))
            }
            <Image
              src={radarShot}
              alt="The rustywx NHC Tropical Cyclones panel showing Tropical Storm Bertha at 40 knots and 1002 mb, map overlay toggles, and graphics products."
              widths={[1329]}
              sizes="1210px"
              loading="lazy"
            />
          </div>
          <figcaption>Tropical Storm Bertha, advisory 14A, in the NHC panel. Numbers match the list.</figcaption>
        </figure>
      </div>
    </section>

    <section class="band forecast" aria-labelledby="forecast-title">
      <header class="section-head">
        <Symbol kind="high" size="lg" />
        <h2 id="forecast-title" class="gothic">And the forecast for where you are.</h2>
      </header>
      <Plate
        id="forecast-plate"
        src={forecastShot}
        alt="The rustywx forecast view: city search, current conditions of 79°F and partly cloudy, a seven-day outlook, and an hourly rain-chance chart."
        caption="The Forecast view. Coordinates were blurred in this screenshot for privacy."
        notes={forecastNotes}
      />
    </section>

    <section class="band honest" aria-labelledby="honest-title">
      <div class="honest-grid">
        <div>
          <header class="section-head">
            <Symbol kind="low" size="lg" />
            <h2 id="honest-title" class="gothic">Honest radar.</h2>
          </header>
          <p class="intro">
            rustywx shows what the radar saw. Filters that remove clutter and noise are on by default and adjustable.
            Anything cosmetic, or anything that could hide real weather, stays off until you turn it on.
          </p>
          <p class="intro">
            Every switch lives in the settings panel and is described in the <a href={href('/docs/quality-control/')}>quality control guide</a>.
          </p>
        </div>
        <ul class="ledger qc">
          {
            qc.map((f) => (
              <li class:list={[{ off: !f.on }]}>
                <span>
                  <strong>{f.name}</strong>
                  <span class="note">{f.note}</span>
                </span>
                <span class="value state">{f.on ? (f.value ?? 'ON') : 'OFF'}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="band demo" aria-labelledby="demo-title">
      <header class="section-head">
        <Symbol kind="warm" size="lg" />
        <h2 id="demo-title" class="gothic">Quiet sky? Replay a famous one.</h2>
      </header>
      <p class="intro">
        Demo mode downloads one historical volume from the NOAA archive, caches it, and pauses live polling. The status
        line reads <code>DEMO —</code> so a screenshot is never mistaken for live data.
      </p>
      <dl class="demos">
        <div>
          <dt><code>rustywx --demo moore2013</code></dt>
          <dd>Moore, Oklahoma EF5 tornado <span class="value">KTLX · 2013-05-20 20:16 UTC</span></dd>
        </div>
        <div>
          <dt><code>rustywx --demo harvey2017</code></dt>
          <dd>Hurricane Harvey landfall <span class="value">KCRP · 2017-08-26 03:04 UTC</span></dd>
        </div>
        <div>
          <dt><code>rustywx --demo &lt;file&gt;</code></dt>
          <dd>Any Level II volume you already have <span class="value">site from the file name</span></dd>
        </div>
      </dl>
    </section>

    <section class="band install" id="install" aria-labelledby="install-title">
      <header class="section-head">
        <Symbol kind="site" size="lg" filled />
        <h2 id="install-title" class="gothic">Install rustywx {VERSION}.</h2>
      </header>
      <div class="install-grid">
        <div>
          <p class="intro">
            Released {RELEASED}. Prebuilt for Apple Silicon Macs, 64-bit Windows, and Linux on x86-64 and ARM64. Intel
            Macs build from source with cargo.
          </p>
          <InstallKey />
        </div>
        <table class="builds">
          <caption class="visually-hidden">All v{VERSION} downloads</caption>
          <thead>
            <tr><th scope="col">System</th><th scope="col">Build</th><th scope="col" class="num">Size</th></tr>
          </thead>
          <tbody>
            {
              DOWNLOADS.map((d) => (
                <tr>
                  <th scope="row">
                    {d.label} <span class="arch">{d.arch}</span>
                  </th>
                  <td><a href={d.href}>{d.kind}</a></td>
                  <td class="num value">{d.mb} MB</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="install-notes">
        <div>
          <h3>Linux AppImage</h3>
          <p>Signed and self-contained. Download the matching <code>.sha256</code> too, then:</p>
          <pre><code>sha256sum --check rustywx-{VERSION}-x86_64.AppImage.sha256
chmod +x rustywx-{VERSION}-x86_64.AppImage
./rustywx-{VERSION}-x86_64.AppImage</code></pre>
        </div>
        <div>
          <h3>What it needs</h3>
          <p>
            A working GPU and graphics stack, and a network connection. On Linux it prefers native Wayland and falls back
            to X11 on its own. A headless server won't open a window.
          </p>
          <p><a href={href('/docs/install/')}>Full install guide</a> · <a href={RELEASE_TAG}>Release notes</a> · <a href={CRATE}>crates.io</a></p>
        </div>
      </div>
    </section>

    <section class="band source" aria-labelledby="source-title">
      <header class="section-head">
        <Symbol kind="isobar" size="lg" />
        <h2 id="source-title" class="gothic">Open source, down to the last gate.</h2>
      </header>
      <div class="source-grid">
        <p class="intro">
          rustywx is written in Rust and licensed AGPL-3.0. The data path runs in one direction, from the S3 archive to
          a background worker, a thin scan model, the rasterizer and your screen, and every stage is small enough to read
          in an afternoon. Bug reports, ideas and pull requests are welcome.
        </p>
        <ul class="ledger">
          <li><a href={href('/docs/architecture/')}>Architecture and data flow</a><span class="value">docs</span></li>
          <li><a href={href('/docs/contributing/')}>Build, test and lint</a><span class="value">just ci</span></li>
          <li><a href={REPO}>Source code</a><span class="value">GitHub</span></li>
          <li><a href={`${REPO}/discussions`}>Questions and ideas</a><span class="value">Discussions</span></li>
        </ul>
      </div>
    </section>
      <p class="edition lettering" aria-hidden="true">
        <span>rustywx radar sheet</span><span class="value">v{VERSION}</span><span>Front: illustrative analysis · sites, scales and screens: real</span>
      </p>
    </div>
  </main>
</Base>

<script>
  const trimMargins = () => {
    for (const m of document.querySelectorAll<HTMLElement>('.margin')) {
      const bottom = m.getBoundingClientRect().bottom;
      m.querySelectorAll<HTMLElement>('span').forEach((s) => {
        s.style.visibility = '';
        if (s.getBoundingClientRect().bottom > bottom - 4) s.style.visibility = 'hidden';
      });
    }
  };
  addEventListener('load', trimMargins);
  addEventListener('resize', trimMargins);

  const svg = document.querySelector<SVGSVGElement>('[data-analysis]');
  const control = document.querySelector<HTMLElement>('[data-site-control]');
  if (svg) {
    // On phones, frame the sheet on the lower 48 instead of the open Pacific.
    const narrow = matchMedia('(max-width: 899px)');
    const frame = () => svg.setAttribute('viewBox', narrow.matches ? '610 0 960 700' : '0 0 1600 860');
    frame();
    narrow.addEventListener('change', frame);
  }
  if (svg && control) {
    const dots = Array.from(svg.querySelectorAll<SVGCircleElement>('[data-sites] circle'));
    const rings = svg.querySelector<SVGGElement>('[data-rings]')!;
    const tag = svg.querySelector<SVGGElement>('[data-tag]')!;
    const tagText = svg.querySelector<SVGTextElement>('[data-tag-text]')!;
    const idEl = control.querySelector('[data-site-id]')!;
    const nameEl = control.querySelector('[data-site-name]')!;
    const coordsEl = control.querySelector('[data-site-coords]')!;
    let index = dots.findIndex((d) => d.dataset.id === 'KJGX');

    const select = (i: number) => {
      index = (i + dots.length) % dots.length;
      const d = dots[index];
      dots.forEach((x) => x.classList.toggle('selected', x === d));
      const x = d.cx.baseVal.value;
      const y = d.cy.baseVal.value;
      const k = Number(d.dataset.k);
      rings.setAttribute('transform', `translate(${x} ${y})`);
      rings.style.transform = '';
      rings.querySelectorAll<SVGCircleElement>('[data-ring]').forEach((c) => c.setAttribute('r', String(Number(c.dataset.ring) * k)));
      const r = 230 * k;
      rings.querySelector('[data-spokes]')!.setAttribute('d', `M0,-${r}V${r}M-${r},0H${r}`);
      tag.setAttribute('transform', `translate(${x} ${y})`);
      tagText.textContent = d.dataset.id!;
      idEl.textContent = d.dataset.id!;
      nameEl.textContent = d.dataset.name!;
      const lat = Number(d.dataset.lat);
      const lon = Number(d.dataset.lon);
      coordsEl.textContent = `${lat.toFixed(2)}°N ${Math.abs(lon).toFixed(2)}°W`;
    };

    control.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-site-step]');
      if (b) select(index + Number(b.dataset.siteStep));
    });

    svg.addEventListener('click', (e) => {
      const c = (e.target as Element).closest<SVGCircleElement>('[data-sites] circle');
      if (c) select(dots.indexOf(c));
    });

    let heroVisible = true;
    new IntersectionObserver(([entry]) => (heroVisible = entry.isIntersecting), { threshold: 0.2 }).observe(svg);

    document.addEventListener('keydown', (e) => {
      if (!heroVisible || e.altKey || e.ctrlKey || e.metaKey) return;
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, select, [contenteditable]')) return;
      if (e.key === 'ArrowRight') select(index + 1);
      else if (e.key === 'ArrowLeft') select(index - 1);
      else return;
      e.preventDefault();
    });
  }
</script>

